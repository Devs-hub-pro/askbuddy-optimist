page {
  background: #f5f7fb;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

.page-header {
  margin-bottom: 16rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.3;
}

.page-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.subtitle {
  font-size: 24rpx;
  color: #64748b;
}

button {
  border-radius: 999rpx;
  font-size: 24rpx;
}

.button-primary {
  background: #16a34a;
  color: #ffffff;
  border: none;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx);
}
