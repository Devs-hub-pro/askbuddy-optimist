.input {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 16rpx;
  padding: 18rpx;
}

.section-row {
  margin-top: 16rpx;
}

.mode-switch {
  display: flex;
  gap: 10rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.action-grid button {
  width: 100%;
  min-width: 0;
  margin: 0;
  box-sizing: border-box;
}

.action-card {
  margin-top: 20rpx;
}

.session-status {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}

.status-label {
  margin-bottom: 6rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
}

.session-id {
  margin-top: 6rpx;
  word-break: break-all;
}

.error-text {
  margin-top: 14rpx;
  color: #dc2626;
  font-size: 24rpx;
}

.poll-text {
  margin-top: 10rpx;
  color: #b45309;
  font-size: 24rpx;
}
