<view class="container safe-bottom">
  <view class="page-header">
    <view class="page-title">首页</view>
    <view class="page-subtitle">实时问答与求助广场</view>
  </view>

  <view class="card quick-panel">
    <view class="section-title">今日推荐</view>
    <view class="quick-row">
      <view class="quick-item">
        <view class="quick-value">{{list.length}}</view>
        <view class="quick-label">问题</view>
      </view>
      <view class="quick-item">
        <view class="quick-value">48h</view>
        <view class="quick-label">活跃窗口</view>
      </view>
      <view class="quick-item">
        <view class="quick-value">A</view>
        <view class="quick-label">契约版本</view>
      </view>
    </view>
  </view>

  <view class="feed-header row">
    <view class="section-title">最新问题</view>
    <view class="feed-tip">下拉可刷新</view>
  </view>

  <state-card wx:if="{{loading}}" title="加载中" desc="正在拉取问题列表" />
  <state-card wx:elif="{{error}}" title="加载失败" desc="{{error}}" actionText="重试" bind:action="loadData" />
  <state-card wx:elif="{{!list.length}}" title="暂无数据" desc="当前没有可展示的问题" />

  <view wx:else class="feed-list">
    <view wx:for="{{list}}" wx:key="id" class="card question-card" bindtap="goDetail" data-id="{{item.id}}">
      <view class="question-title">{{item.title}}</view>
      <view class="question-content">{{item.content || '暂无描述'}}</view>
      <view class="question-meta row">
        <view class="meta-left">{{item.status || '-'}}</view>
        <view class="meta-right">{{item.created_at_text}}</view>
      </view>
    </view>
  </view>
</view>
