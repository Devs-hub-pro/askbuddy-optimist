<view class="container safe-bottom">
  <view class="page-header">
    <view class="page-title">首页</view>
    <view class="page-subtitle">与你的 iOS 信息架构保持一致</view>
  </view>

  <state-card wx:if="{{loading}}" title="加载中" desc="正在拉取问题列表" />
  <state-card wx:elif="{{error}}" title="加载失败" desc="{{error}}" actionText="重试" bind:action="loadData" />
  <state-card wx:elif="{{!list.length}}" title="暂无数据" desc="当前没有可展示的问题" />

  <view wx:else>
    <view wx:for="{{list}}" wx:key="id" class="card" style="margin-top: 20rpx;" bindtap="goDetail" data-id="{{item.id}}">
      <view class="title" style="font-size: 32rpx;">{{item.title}}</view>
      <view class="subtitle" style="margin-top: 10rpx;">{{item.content || '暂无描述'}}</view>
      <view class="row" style="margin-top: 14rpx;">
        <text class="subtitle">状态：{{item.status || '-'}}</text>
        <text class="subtitle">{{item.created_at_text}}</text>
      </view>
    </view>
  </view>
</view>
