<view class="container safe-bottom">
  <view class="row">
    <view>
      <view class="page-title">消息</view>
      <view class="page-subtitle">未读通知 {{unreadCount}}</view>
    </view>
    <view class="page-actions">
      <button size="mini" bindtap="loadData">刷新</button>
      <button size="mini" bindtap="goCallPage">去通话联调页</button>
    </view>
  </view>

  <state-card wx:if="{{loading}}" title="加载中" desc="正在读取通知与未读数" />
  <state-card wx:elif="{{error}}" title="加载失败" desc="{{error}}" actionText="重试" bind:action="loadData" />
  <state-card wx:elif="{{!list.length}}" title="暂无通知" desc="当前账号暂无可读通知" />

  <view wx:else>
    <view wx:for="{{list}}" wx:key="id" class="card" style="margin-top: 20rpx;" bindtap="openRelated" data-related-id="{{item.related_id}}" data-related-type="{{item.related_type}}">
      <view class="row">
        <view class="title" style="font-size: 30rpx;">{{item.title || item.type}}</view>
        <text wx:if="{{!item.is_read}}" class="dot" />
      </view>
      <view class="subtitle" style="margin-top: 8rpx;">{{item.content || '-'}}</view>
      <view class="subtitle" style="margin-top: 8rpx;">{{item.created_at_text}}</view>
    </view>
  </view>
</view>
