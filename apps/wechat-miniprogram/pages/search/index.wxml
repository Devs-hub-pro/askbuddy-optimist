<view class="container safe-bottom">
  <view class="page-header">
    <view class="page-title">搜索</view>
    <view class="page-subtitle">按问题、专家、技能、动态快速定位</view>
  </view>

  <view class="card search-panel">
    <view class="search-row">
      <input class="search-input" placeholder="输入关键词，例如：前端面试" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onConfirmSearch" />
      <button class="button-primary search-btn" size="mini" bindtap="onConfirmSearch">搜索</button>
    </view>

    <view class="type-tabs">
      <view class="type-tab {{activeType === 'question' ? 'active' : ''}}" data-type="question" bindtap="switchType">问题</view>
      <view class="type-tab {{activeType === 'expert' ? 'active' : ''}}" data-type="expert" bindtap="switchType">专家</view>
      <view class="type-tab {{activeType === 'skill' ? 'active' : ''}}" data-type="skill" bindtap="switchType">技能</view>
      <view class="type-tab {{activeType === 'post' ? 'active' : ''}}" data-type="post" bindtap="switchType">动态</view>
    </view>
  </view>

  <state-card wx:if="{{loading}}" title="搜索中" desc="正在请求内容" />
  <state-card wx:elif="{{error}}" title="搜索失败" desc="{{error}}" actionText="重试" bind:action="runSearch" />

  <view wx:elif="{{activeType === 'question'}}">
    <state-card wx:if="{{!resultBag.question.length}}" title="暂无问题结果" desc="试试更具体的关键词" />
    <view wx:for="{{resultBag.question}}" wx:key="id" class="card result-card" bindtap="goQuestionDetail" data-id="{{item.id}}">
      <view class="result-title">{{item.title}}</view>
      <view class="result-desc">{{item.content || '暂无描述'}}</view>
    </view>
  </view>

  <view wx:elif="{{activeType === 'expert'}}">
    <state-card wx:if="{{!resultBag.expert.length}}" title="暂无专家结果" desc="请更换关键词" />
    <view wx:for="{{resultBag.expert}}" wx:key="id" class="card result-card">
      <view class="result-title">{{item.nickname || item.title || '未命名专家'}}</view>
      <view class="result-desc">{{item.headline || item.intro || item.bio || '-'}}</view>
    </view>
  </view>

  <view wx:elif="{{activeType === 'skill'}}">
    <state-card wx:if="{{!resultBag.skill.length}}" title="暂无技能结果" desc="请更换关键词" />
    <view wx:for="{{resultBag.skill}}" wx:key="id" class="card result-card">
      <view class="result-title">{{item.title || '未命名技能'}}</view>
      <view class="result-desc">{{item.category_name || item.description || '-'}}</view>
    </view>
  </view>

  <view wx:else>
    <state-card wx:if="{{!resultBag.post.length}}" title="暂无动态结果" desc="请更换关键词" />
    <view wx:for="{{resultBag.post}}" wx:key="id" class="card result-card">
      <view class="result-desc">{{item.content || item.title || '-'}}</view>
    </view>
  </view>
</view>
