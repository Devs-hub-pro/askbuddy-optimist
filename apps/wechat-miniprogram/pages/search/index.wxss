input {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 16rpx;
  padding: 18rpx;
}

.type-tabs {
  margin-top: 16rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.type-tab {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  color: #64748b;
}

.type-tab.active {
  border-color: #16a34a;
  color: #15803d;
  background: #ecfdf3;
}
